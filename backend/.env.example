# ---------------- LLM providers (fill in at least ONE) ----------------
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# groq | openai | auto  (auto = use whichever key is set, Groq preferred)
LLM_PROVIDER_PRIORITY=auto

# ---------------- ML weights ----------------
# auto  = download real pretrained weights on first use (needs internet)
# local = only use weights already cached in MODEL_CACHE_DIR
# off   = always use the classical-CV fallback pipeline (real algorithms,
#         no deep weights needed at all — good for a demo machine with no GPU/internet)
MODEL_WEIGHTS_MODE=auto
MODEL_CACHE_DIR=./model_cache
DEVICE=cpu

# Fine-tuned head checkpoints (optional — see backend/train/*.py to produce these)
EUROSAT_HEAD_WEIGHTS=
CHANGE_HEAD_WEIGHTS=
SAR_FUSION_HEAD_WEIGHTS=
